# Copy as .env.staging or .env.production on the VPS (never in the repo) with permissions 600.
# Only letters and numbers in passwords and secrets (special characters break .env and connection strings).
# Generar: openssl rand -base64 128 | tr -dc 'A-Za-z0-9' | head -c 64
# Different values in each environment.

# staging or production (name of the Compose project and of the volumes)
ENVIRONMENT=staging
# Staging o Production
ASPNETCORE_ENVIRONMENT=Staging
# Image version: set by scripts/deploy.sh (this repo's commit); it can be fixed to roll back.
VERSION=

# Public domain of the API (a DNS A record pointing to the VPS) and email for Let's Encrypt
API_DOMAIN=
ACME_EMAIL=

# Origin of the web client that calls the API from the browser (CORS), e.g. https://pos.yourbakery.co
CORS_ALLOWED_ORIGIN=

POSTGRES_PASSWORD=
# At least 32 characters. Rotating it closes all sessions.
JWT_SECRET=

# Optional: the application's name towards Siigo (Partner-Id)
SIIGO_PARTNER_ID=

# Backups (scripts/backup.sh): local folder and days they are kept. Also copy them off the VPS.
BACKUP_DIR=/var/backups/bakerypos
BACKUP_RETENTION_DAYS=14
