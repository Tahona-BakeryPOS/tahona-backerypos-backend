# Copia como .env.staging o .env.production en el VPS (nunca en el repo) con permisos 600.
# Solo letras y números en contraseñas y secretos (los caracteres especiales rompen .env y las cadenas de conexión).
# Generar: openssl rand -base64 128 | tr -dc 'A-Za-z0-9' | head -c 64
# Valores distintos en cada ambiente.

# staging o production (nombre del proyecto de Compose y de los volúmenes)
ENVIRONMENT=staging
# Staging o Production
ASPNETCORE_ENVIRONMENT=Staging
# Versión de las imágenes: la pone scripts/deploy.sh (commit de este repo); se puede fijar para volver atrás.
VERSION=

# Dominio público del API (DNS tipo A apuntando al VPS) y correo para Let's Encrypt
API_DOMAIN=
ACME_EMAIL=

# Origen del cliente web que llama al API desde el navegador (CORS), p. ej. https://pos.tupanaderia.co
CORS_ALLOWED_ORIGIN=

POSTGRES_PASSWORD=
# Mínimo 32 caracteres. Rotarlo cierra todas las sesiones.
JWT_SECRET=

# Opcional: nombre de la aplicación ante Siigo (Partner-Id)
SIIGO_PARTNER_ID=

# Backups (scripts/backup.sh): carpeta local y días que se conservan. Cópialos además fuera del VPS.
BACKUP_DIR=/var/backups/bakerypos
BACKUP_RETENTION_DAYS=14
