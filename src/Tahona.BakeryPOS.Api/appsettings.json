{
  "Jwt": {
    "Issuer": "BakeryPOS",
    "Audience": "BakeryPOS.Client",
    "AccessTokenMinutes": 60
  },
  "Outbox": {
    "Enabled": true,
    "BatchSize": 20,
    "PollInterval": "00:00:02",
    "MaxAttempts": 10
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
